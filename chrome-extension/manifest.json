{
  "manifest_version": 3,
  "name": "200 Account Automation Monitor",
  "version": "1.0.0",
  "description": "Real-time error notifications for 200 account automation system",
  "permissions": [
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
